# Copy to .env and fill in locally. Never commit the real .env file.
# BuildGuard AI runs fully on the demo dataset + local file-based MLflow with
# no required secrets — this file exists for optional local overrides only.

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
BUILDGUARD_LOG_LEVEL=INFO

# Local, file-based MLflow tracking URI (zero-cost; no remote tracking server).
MLFLOW_TRACKING_URI=file:./mlruns

# Only relevant if a licensed external economic-index provider is configured
# (see docs/DATA_PRIVACY.md, "Public economic indicators"). The public
# demo app must run without this variable set, using DemoIndexProvider.
# ECONOMIC_INDEX_API_KEY=
