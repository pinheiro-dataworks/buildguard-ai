# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- uv ----
# uv.lock IS committed (reproducibility). Only ignore local cache artifacts.
.uv-cache/

# ---- Testing & coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- MLflow (local, file-based tracking; never commit run artifacts) ----
mlruns/
mlartifacts/

# ---- Data (large / generated / external-reference) ----
# Small, deterministic synthetic samples under data/sample/ ARE committed.
data/raw/
data/processed/
data/interim/
# External reference datasets are for local EDA/calibration only — never
# redistributed in this public repo. See data/external/README.md.
data/external/**
!data/external/README.md

# ---- Models & large artifacts ----
# The three champion joblib files ARE committed, deliberately (Section
# 54: "packaged artifacts in-repo... when size permits" -- ~6MB total,
# well under it). Streamlit Community Cloud deploys straight from this
# repo with no build/training step (ADR-0013), so the deployed app has
# no way to produce them itself -- only *.pkl/*.cbm/*.txt (formats this
# project never actually produces) stay ignored, as a guard against
# accidentally committing some other framework's model dump later.
models/*.pkl
models/*.cbm
models/*.txt
!models/README.md

# ---- Reports (generated, reproducible from code — not committed) ----
reports/figures/*
reports/metrics/*
reports/monitoring/*
!reports/figures/.gitkeep
!reports/metrics/.gitkeep
!reports/monitoring/.gitkeep
# The monitoring report itself is small and is real evidence (Section 23:
# "implemented, not just documented") -- committed like the other
# reports/experiments/*.json summaries, unlike figures/metrics.
!reports/monitoring/monitoring_report.json

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- Docker ----
*.log

# ---- Streamlit ----
.streamlit/secrets.toml
