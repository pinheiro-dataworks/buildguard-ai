# Environment / caches -- never shipped, always regenerated
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# VCS / editor
.git/
.github/
.vscode/
.idea/

# Local-only / gitignored data (Section 32: no secrets, no local-only data)
data/processed/
data/external/
mlruns/

# Trained artifacts are rebuilt inside the image (see Dockerfile) --
# never trust a stale host-side models/ directory into the build context.
models/*.joblib

# Scratch
*.log
.env
